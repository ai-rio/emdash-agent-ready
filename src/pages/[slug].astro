---
import {
	decodeSlug,
	getEmDashEntry,
	getMenuWithCacheHint,
	getSeoMeta,
} from "emdash";
import Base from "../layouts/Base.astro";
import EditorNote from "../components/EditorNote.astro";
import PageView from "../components/PageView.astro";
import { layoutDescription } from "../utils/page";
import { getSelectedWork } from "../utils/selected-work";
import { DEFAULT_LOCALE, HTML_LANG, getLocale, localeUrl, slugOf } from "../i18n";
import { ui } from "../i18n/ui";
import { faqNode, type WebPageType } from "../seo/jsonld";
import { absolutize, pageToMarkdown } from "../utils/markdown";
import { markdownResponse, wantsMarkdown } from "../utils/negotiate";

// The seeded menu links to these pages. While the menu links to one that
// doesn't exist, as on a site set up without sample content, the link shows a
// placeholder instead of a 404.
const PLACEHOLDER_TITLES = new Map([
	["about", "About"],
	["contact", "Contact"],
]);
const TRAILING_SLASHES = /\/+$/;

const slug = decodeSlug(Astro.params.slug);
// Page slugs never contain dots, so requests for files such as /favicon.ico
// or /wp-login.php go to the 404 page without a database lookup.
if (!slug || slug.includes(".")) return Astro.rewrite("/404");

const locale = getLocale(Astro);
const {
	entry: page,
	error,
	cacheHint,
	fallbackLocale,
} = await getEmDashEntry("pages", slug, { locale });
if (error) return new Response("Could not load the page", { status: 500 });

async function menuLinksTo(path: string): Promise<boolean> {
	const { data: menu } = await getMenuWithCacheHint("primary", { locale });
	return (menu?.items ?? []).some((item) => {
		try {
			return (
				new URL(item.url, Astro.url).pathname.replace(TRAILING_SLASHES, "") === path
			);
		} catch {
			return false;
		}
	});
}

const placeholderTitle = page ? undefined : PLACEHOLDER_TITLES.get(slug);
if (!page && !(placeholderTitle && (await menuLinksTo(`/${slug}`)))) {
	return Astro.rewrite("/404");
}

// Selected work shares this query with the page, whose cache entry must clear
// when projects change.
const projectsResult = page?.data.layout?.some(
	(block) => block._type === "portfolio_selected_work",
)
	? await getSelectedWork(locale)
	: undefined;

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (projectsResult?.cacheHint) Astro.cache.set(projectsResult.cacheHint);
	// A missing entry carries no tags, so publishing the page later wouldn't
	// clear the cached placeholder.
	if (!page) Astro.cache.set({ tags: ["pages"] });
}

const placeholderNote =
	slug === "contact"
		? "Create or publish a page with the slug “contact” in Pages and add a Contact details block to its Layout to replace this placeholder."
		: `Create or publish a page with the slug “${slug}” in Pages to replace this placeholder.`;

const tx = ui[locale];
if (page && wantsMarkdown(Astro.request)) {
	const projectLinks = projectsResult?.entries.map(
		(project) =>
			`- [${project.data.title || tx.untitled}](${new URL(localeUrl(locale, `/work/${slugOf(project.id)}`), Astro.url.origin).href})`,
	);
	return markdownResponse(
		absolutize(pageToMarkdown(page, tx, { projectLinks }), Astro.url.origin),
	);
}

const ABOUT_SLUGS = new Set(["about", "sobre", "acerca-de"]);
const webPageType: WebPageType = page?.data.layout?.some(
	(block) => block._type === "portfolio_contact",
)
	? "ContactPage"
	: ABOUT_SLUGS.has(slugOf(page?.id ?? slug))
		? "AboutPage"
		: "WebPage";
const pageTitle = page?.data.title ?? placeholderTitle ?? slug;
const crumbs = [
	{ name: tx.home, url: new URL(localeUrl(locale, "/"), Astro.url.origin).href },
	{ name: pageTitle, url: new URL(localeUrl(locale, `/${slugOf(page?.id ?? slug)}`), Astro.url.origin).href },
];

const faqItems = (page?.data.layout ?? []).flatMap((block) =>
	block._type === "portfolio_faq"
		? (block.items ?? []).map((item) => ({
				question: item.question,
				answer: item.answer,
			}))
		: [],
);

const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: localeUrl(locale, `/${slugOf(page.id)}`),
			defaultDescription: layoutDescription(page.data.layout),
		})
	: null;
---

<Base
	title={seo?.title ?? placeholderTitle}
	pageTitle={seo?.ogTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={page && fallbackLocale
		? new URL(localeUrl(DEFAULT_LOCALE, `/${slugOf(page.id)}`), Astro.url.origin).href
		: seo?.canonical}
	robots={page && !fallbackLocale ? seo?.robots : "noindex"}
	breadcrumbs={crumbs}
	webPageType={webPageType}
	schema={(url) =>
		faqItems.length > 0
			? [faqNode({ url, inLanguage: HTML_LANG[locale], items: faqItems })]
			: []}
	datePublished={page?.data.publishedAt}
	dateModified={page?.data.updatedAt}
	content={page
		? { collection: "pages", id: page.data.id, slug: slugOf(page.id) }
		: undefined}
>
	<PageView page={page} title={placeholderTitle} />
	{
		!page && (
			<EditorNote href="/_emdash/admin/content/pages" action="Go to Pages">
				{placeholderNote}
			</EditorNote>
		)
	}
</Base>
