---
import Base from "../layouts/Base.astro";
import { getLocale, localeUrl } from "../i18n";
import { ui } from "../i18n/ui";

const locale = getLocale(Astro);
const tx = ui[locale];
---

<Base title={tx.notFoundTitle} robots="noindex">
	<div class="frame not-found">
		<p class="label">{tx.notFoundLabel}</p>
		<h1 class="not-found__title">{tx.notFoundTitle}</h1>
		<div class="not-found__body">
			<p class="not-found__text">{tx.notFoundText}</p>
			<ul class="not-found__links">
				<li>
					<a href={localeUrl(locale, "/")} class="arrow-link">
						{tx.backHome}
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 12h16M13 5l7 7-7 7"></path>
						</svg>
					</a>
				</li>
				<li>
					<a href={localeUrl(locale, "/work")} class="arrow-link">
						{tx.browseWork}
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 12h16M13 5l7 7-7 7"></path>
						</svg>
					</a>
				</li>
			</ul>
		</div>
	</div>
</Base>

<style>
	.not-found {
		padding-block-start: var(--page-head-space);
	}

	.not-found__title {
		margin-block-start: var(--spacing-md);
		font-size: var(--font-size-title);
		line-height: var(--leading-none);
		letter-spacing: var(--tracking-display);
		overflow-wrap: anywhere;
	}

	.not-found__body {
		display: grid;
		justify-items: start;
		gap: var(--spacing-lg);
		margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
		padding-block-start: var(--spacing-lg);
		border-block-start: 1px solid var(--color-border);
	}

	.not-found__text {
		max-width: 36ch;
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		color: var(--color-text-secondary);
	}

	.not-found__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm) var(--spacing-xl);
		list-style: none;
	}

	.not-found__links a {
		padding-block: var(--spacing-xs);
		font-size: var(--font-size-md);
	}
</style>
